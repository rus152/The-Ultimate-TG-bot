# Rename this file to .env

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
DEBUG_CHAT_ID=your_debug_chat_id # -1001234567890
DEBUG_MODE=toggle_debug_mode # True or False
WHISPER_SERVER_URL=http://localhost:3373 # URL запущенного whisper-server
WHISPER_SERVER_TIMEOUT=180 # Таймаут распознавания в секундах
