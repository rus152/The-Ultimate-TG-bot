# Rename this file to .env

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
DEBUG_CHAT_ID=your_debug_chat_id # -1001234567890
DEBUG_MODE=False # True or False
WHISPER_SERVER_URLS=http://localhost:3373 # Один или несколько адресов через запятую
WHISPER_SERVER_TIMEOUT=180 # Таймаут распознавания в секундах
WHISPER_HEALTH_INTERVAL=60 # Интервал фоновой проверки серверов в секундах
WHISPER_HEALTH_TIMEOUT=10 # Таймаут одного health-check в секундах
WHISPER_LANGUAGE= # Пусто — автоопределение; например, ru или en — фиксированный язык
